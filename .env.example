# Local development
CLIENT_ORIGIN=http://localhost:5173
MAX_ROOM_PARTICIPANTS=12

# Comma-separated STUN/TURN URLs. For production, use a TURN service.
# VITE_ICE_SERVERS=stun:stun.l.google.com:19302,turn:turn.example.com:3478

# PWA build-time Socket.io URL. For a static frontend, set this to the Render Web Service URL.
# VITE_SIGNAL_SERVER_URL=https://mar-ci-connect-api.onrender.com

# Optional: public PWA URL used by the VS Code extension.
# MARCI_CONNECT_URL=https://mar-ci-connect.vercel.app
# MARCI_SIGNAL_URL=https://mar-ci-connect-api.onrender.com